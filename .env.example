# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# Comma-separated list of ICS calendar URLs
ICS_URLS=https://calendar.google.com/calendar/ical/example%40gmail.com/private-abc123/basic.ics

# Full TRMNL private plugin webhook URL (the UUID in the path is the auth token)
# Found in your TRMNL plugin instance settings after saving the plugin.
TRMNL_WEBHOOK_URL=https://trmnl.com/api/custom_plugins/your-plugin-uuid-here

# Timezone for determining "today" and "tomorrow" (IANA timezone name)
TIMEZONE=America/New_York
