<div class="layout layout--col layout--stretch">
  <div class="list" data-list-limit="true" data-list-hidden-count="true" data-list-max-columns="1">
    {% for allday in today_allday_events %}
    <div class="item">
      <div class="meta">
        <span class="index">1</span>
      </div>
      <div class="content">
        <span class="title title--small text--gray-20">{{allday.title}}</span>
      </div>
    </div>
    {% endfor %}
    {%for timed in today_timed_events %}
    <div class="item">
      <div class="meta">
        <span class="index">1</span>
      </div>
      <div class="content">
        <span class="title title--small">{{timed.title}}</span>
        <div class="flex gap--xsmall">
          <span class="label label--small label--underline">10:00 - 11:00</span>
        </div>
      </div>
    </div>
    {% endfor %}
  </div>
</div>

<div class="title_bar">
  <img class="image" src="https://trmnl.com/images/plugins/trmnl--render.svg">
  <span class="title">{{ trmnl.plugin_settings.instance_name }}</span>
  <span class="instance">{{today_label}}</span>
</div>